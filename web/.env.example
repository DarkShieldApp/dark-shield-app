# Configuración pública de Supabase para la aplicación web.
# Copiar a web/.env.local y completar desde el panel de Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# No añadir aquí claves secretas, service_role ni claves de IA.
# Las claves secretas solo pueden usarse en operaciones de servidor que las necesiten.
